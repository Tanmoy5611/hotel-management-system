{
  "typescript": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": "always",
    "quoteStyle": "alwaysSingle"
  },
  "json": {
    "indentWidth": 2
  },
  "markdown": {
    "lineWidth": 100
  },
  "includes": [
    "src/main/js/**/*.js",
    "webpack.config.js",
    "eslint.config.js",
    "package.json",
    "README.md"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.95.11.wasm",
    "https://plugins.dprint.dev/json-0.20.0.wasm",
    "https://plugins.dprint.dev/markdown-0.18.0.wasm"
  ]
}